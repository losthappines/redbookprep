# Environment variables template for RedBookPrep
# Copy this file to .env.local for local development (never commit .env.local)

# Public site URL (used for metadata / redirects)
NEXT_PUBLIC_SITE_URL=https://redbookprep.site

# Server-only secrets (Configure in Firebase App Hosting -> Settings -> Environment)
# GEMINI_API_KEY=your_gemini_api_key_here
