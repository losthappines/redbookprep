# Environment variables template for RedBookPrep
# Copy this file to .env.local for local development (never commit .env.local)

# Public site URL (used for metadata / redirects)
NEXT_PUBLIC_SITE_URL=https://redbookprep.site

# Supabase (Auth: Google OAuth + Email OTP / Magic Link, PostgreSQL + RLS, Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Desmos Production API Key (register redbookprep.site in Desmos Partner Console)
NEXT_PUBLIC_DESMOS_API_KEY=your_desmos_production_api_key

# Stripe Subscriptions (Plus / Pro + Parent Sponsor Checkout)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PLUS_MONTHLY=price_...
# STRIPE_PRICE_PRO_MONTHLY=price_...

# Server-managed AI Providers (redCoach + adaptive coaching + OCR extraction)
# GEMINI_API_KEY=your_gemini_api_key_here
# GROQ_API_KEY=your_groq_api_key_here
# MISTRAL_API_KEY=your_mistral_api_key_here
# GEMMA_API_KEY=your_gemma_api_key_here

# Legacy Firebase (deprecated — kept only for optional fallback migration)
# NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
# NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
