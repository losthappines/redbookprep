          "options": [
            "ingenious",
            "meticulous",
            "pristine",
            "affecting"
          ],
          "answer": 3,
          "explanation": "Correct answer is D (Answer Key: Topic 12, Q1). Verified from SAToplam 2.0 Reading real exam compilation."
        },
        {
          "id": "satoplam-t12-q002",
          "skill": "Words in Context - Gap Filling",
          "domain": "Craft and Structure",
          "focus": "Select the most logical and precise word or phrase to complete the context",
          "source": "SAToplam 2.0 · Topic 12 · Q2",
          "passageTitle": "Words in Context - Gap Filling — Q2",
          "passage": "The Al-Fattah Al-Aleem Mosque in the New\nAdministrative Capital, Egypt, is a massive\nmosque that can accommodate approximately\n17,000 people at once, making it an\n______________ sight to behold.",
          "prompt": "Which choice completes the text with the most\nlogical and precise word or phrase?",
