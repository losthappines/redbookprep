        {
          "id": "satoplam-t12-q015",
          "skill": "Words in Context - Gap Filling",
          "domain": "Craft and Structure",
          "focus": "Select the most logical and precise word or phrase to complete the context",
          "source": "SAToplam 2.0 · Topic 12 · Q15",
          "passageTitle": "Words in Context - Gap Filling — Q15",
          "passage": "With his widely celebrated portraits of poet\nSeamus Heaney, molecular biologist Struther\nArnott, and other prominent figures in different\nfields, British painter Peter Edwards has\n______________ substantial prestige as\nan artist.",
          "prompt": "Which choice completes the text with the most\nlogical and precise word or phrase?",
