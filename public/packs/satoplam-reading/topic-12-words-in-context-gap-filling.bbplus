        },
        {
          "id": "satoplam-t12-q012",
          "skill": "Words in Context - Gap Filling",
          "domain": "Craft and Structure",
          "focus": "Select the most logical and precise word or phrase to complete the context",
          "source": "SAToplam 2.0 · Topic 12 · Q12",
          "passageTitle": "Words in Context - Gap Filling — Q12",
          "passage": "The emphasis on accurately representing the\nexperiences of average working people that is\ncharacteristic of the realist style can be seen in\nThe Gleaners, painted by Jean-François Millet,\nwhich depicts peasants picking stray wheat from\na field after the harvest. This style can thus be\nseen as an effort to ____________ what\nwere regarded as the excesses of the romantic\nstyle evident in many paintings by Horace\nVernet, which instead exaggerated their\nsubjects' beauty or heroism while hiding\nimperfection.",
          "prompt": "Which choice completes the text with the most\nlogical and precise word or phrase?",
          "options": [
            "understand",
            "advance",
            "counteract",
            "accentuate"
          ],
          "answer": 2,
          "explanation": "Correct answer is C (Answer Key: Topic 12, Q12). Verified from SAToplam 2.0 Reading real exam compilation."
        },
        {
          "id": "satoplam-t12-q013",
          "skill": "Words in Context - Gap Filling",
          "domain": "Craft and Structure",
          "focus": "Select the most logical and precise word or phrase to complete the context",
          "source": "SAToplam 2.0 · Topic 12 · Q13",
          "passageTitle": "Words in Context - Gap Filling — Q13",
          "passage": "The swordfish can swim very fast- up to 97\nkilometers per hour (km/hr) but it is\nsignificantly slower than the frigatebird, which\ncan fly at speeds up to 153 km/hr. The\ndifference between these speeds is largely\n__________ of the fact that the features\nthat make flight possible do less to limit top\nspeeds than the features suitable for swimming\nthrough water.",
          "prompt": "Which choice completes the text with the most\nlogical and precise word or phrase?",
          "options": [
            "a consequence",
            "an explanation",
            "a repudiation",
            "an objective"
          ],
          "answer": 0,
          "explanation": "Correct answer is A (Answer Key: Topic 12, Q13). Verified from SAToplam 2.0 Reading real exam compilation."
        },
        {
          "id": "satoplam-t12-q014",
          "skill": "Words in Context - Gap Filling",
          "domain": "Craft and Structure",
          "focus": "Select the most logical and precise word or phrase to complete the context",
          "source": "SAToplam 2.0 · Topic 12 · Q14",
          "passageTitle": "Words in Context - Gap Filling — Q14",
          "passage": "Whether the reign of a French monarch such as\nLouis VII or Henry V was historically\nconsequential or relatively uneventful, its\ntrajectory was shaped by questions of legitimacy\nand therefore cannot be understood without a\ncorollary understanding of the characteristics\nwithout which the monarch would have been\nforced to ______________ the throne.",
