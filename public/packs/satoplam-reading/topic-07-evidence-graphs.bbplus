          "answer": 0,
          "explanation": "Correct answer is A (Answer Key: Topic 7, Q4). Verified from SAToplam 2.0 Reading real exam compilation.",
          "imageDataUrl": "/packs/satoplam-reading/images/topic7_q4.png",
          "imageAlt": "Table/Graph data for Question 4"
